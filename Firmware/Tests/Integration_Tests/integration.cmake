# ===========================================================================
# ffb_integration_tests (integration track, Tests/Integration_Tests/claude/plans/INTEGRATION_TEST_PLAN.md section 3.2): the real firmware
# modules together, with only the hardware boundary faked: real TinyUSB (ffb_usb_tests) on the fake device controller, the
# real TMC4671 / ODrive / VESC / PWM / SimpleMotion / MyActuator drivers (ffb_driver_tests) on the fake SPI / CAN / UART, the
# real firmware core and the CMSIS-DSP functions the firmware calls.
#
# Included by one line of Firmware/Tests/CMakeLists.txt (after the ffb_driver_tests block), so it sees its variables
# (TARGET_*, USB_*, DRIVER_*, DSP_DIR, USE_DSP, FFB_SIMPLEMOTION_BUILT) and the directory scope property settings
# (Axis.cpp -include math.h, TMC4671.cpp / Axis.cpp clang narrowing, ledEffects.cpp renames). No other executable is changed.
#
# Choices where the ffb_usb_tests and ffb_driver_tests blocks differ:
#  - Feature header: Code_Coverage/platform/target_f407_drivers (drivers on, MIDI off), generated wrapper first: the header
#    turns TMCDEBUG on (ffb_driver_tests only). A wrapper target_constants.h in the build directory includes it and then
#    #undef TMCDEBUG, so the debug bridge is not part of this executable (TMCDebugBridge.cpp then compiles to nothing).
#    Code_Coverage/platform/usb_midi and the force-included recording TMC4671.h double are NOT used (MIDI off):
#    MidiMain.cpp, MidiHandler.cpp, host_midi_timer.cpp and FakeTmcPhase.cpp are left out.
#  - Sources: union of TARGET_FIRMWARE_SOURCES, DRIVER_FIRMWARE_SOURCES, USB_FIRMWARE_SOURCES (minus the MIDI files) and
#    USB_TINYUSB_SOURCES; platform sources: DRIVER_PLATFORM_SOURCES minus host_usb.cpp plus host_dcd.cpp, host_usb_osal.cpp.
#  - Definitions: both blocks' (HOSTTEST_RTOS_EXT HOSTTEST_REAL_TINYUSB FFB_F407_TUSB_CONFIG_H, HOSTTEST_NO_SIMPLEMOTION with clang).
#  - Options: the union (-fexceptions for C like the usb block; mallinfo shim for MINGW OR APPLE like the driver block,
#    MinGW static link and -mno-ms-bitfields as in both).
# ===========================================================================
option(FFB_TESTS_INTEGRATION "Build ffb_integration_tests: the integration track (real firmware modules, fake hardware boundary)" ON)

if(FFB_TESTS_INTEGRATION)
	set(INTEGRATION_FIRMWARE_SOURCES ${DRIVER_FIRMWARE_SOURCES} ${USB_FIRMWARE_SOURCES} ${USB_TINYUSB_SOURCES})
	list(REMOVE_ITEM INTEGRATION_FIRMWARE_SOURCES
		${FFBOARD_DIR}/UserExtensions/Src/MidiMain.cpp
		${FFBOARD_DIR}/Src/MidiHandler.cpp)
	list(REMOVE_DUPLICATES INTEGRATION_FIRMWARE_SOURCES)

	set(INTEGRATION_PLATFORM_SOURCES ${DRIVER_PLATFORM_SOURCES})
	list(REMOVE_ITEM INTEGRATION_PLATFORM_SOURCES Code_Coverage/platform/src/host_usb.cpp)
	list(APPEND INTEGRATION_PLATFORM_SOURCES
		Code_Coverage/platform/src/host_dcd.cpp
		Code_Coverage/platform/src/host_usb_osal.cpp)
	list(REMOVE_DUPLICATES INTEGRATION_PLATFORM_SOURCES)

	file(GLOB INTEGRATION_TEST_SOURCES CONFIGURE_DEPENDS
		${CMAKE_CURRENT_SOURCE_DIR}/Integration_Tests/claude/cases/test_*.cpp)

	add_executable(ffb_integration_tests
		${INTEGRATION_FIRMWARE_SOURCES}
		${INTEGRATION_PLATFORM_SOURCES}
		${INTEGRATION_TEST_SOURCES}
		Integration_Tests/support/IntegrationFixture.cpp
		Integration_Tests/support/ChainScheduler.cpp
		Integration_Tests/support/HidReportDescriptor.cpp
		Integration_Tests/support/PidReportBuilder.cpp
		Integration_Tests/support/OscillationDetector.cpp
		Integration_Tests/support/FrequencyResponse.cpp
		Integration_Tests/support/FfbHost.cpp
		Integration_Tests/support/PositionScript.cpp
		Integration_Tests/support/ChipEventLog.cpp
		Integration_Tests/support/CaseWatchdog.cpp
		Integration_Tests/fakes/WheelPlant.cpp
		Code_Coverage/support/test_main.cpp
	)

	# Wrapper of the drivers feature header with TMCDEBUG off (see above). Written at configure time into the build directory.
	set(INTEGRATION_FEATURE_DIR ${CMAKE_CURRENT_BINARY_DIR}/integration_feature)
	file(WRITE ${INTEGRATION_FEATURE_DIR}/target_constants.h.tmp
		"/* generated by Integration_Tests/integration.cmake: the drivers feature header with TMCDEBUG off */\n"
		"#include \"${CMAKE_CURRENT_SOURCE_DIR}/Code_Coverage/platform/target_f407_drivers/target_constants.h\"\n"
		"#ifdef TMCDEBUG\n#undef TMCDEBUG\n#endif\n")
	configure_file(${INTEGRATION_FEATURE_DIR}/target_constants.h.tmp ${INTEGRATION_FEATURE_DIR}/target_constants.h COPYONLY)

	target_include_directories(ffb_integration_tests PRIVATE
		Code_Coverage/platform/usb
		${INTEGRATION_FEATURE_DIR}
		Code_Coverage/platform/target_f407
		Code_Coverage/platform/include
		Integration_Tests/support
		Code_Coverage/support
		Code_Coverage/mocks
		Code_Coverage/third_party
		${FFBOARD_DIR}/Inc
		${FFBOARD_DIR}/UserExtensions/Inc
		${USB_DIR}
		${USB_DIR}/common
		${USB_DIR}/device
		${USB_DIR}/class/hid
		${USB_DIR}/class/cdc
		${USB_DIR}/class/midi
	)

	target_compile_definitions(ffb_integration_tests PRIVATE HOSTTEST HOSTTEST_REAL_CPPMAIN HOSTTEST_REAL_LED_EFFECTS HOSTTEST_TARGET_OTP
		HOSTTEST_RTOS_EXT HOSTTEST_REAL_TINYUSB)
	target_compile_definitions(ffb_integration_tests PRIVATE FFB_F407_TUSB_CONFIG_H="${FFB_F407_TUSB_CONFIG}")
	if(NOT FFB_SIMPLEMOTION_BUILT)
		target_compile_definitions(ffb_integration_tests PRIVATE HOSTTEST_NO_SIMPLEMOTION)
	endif()

	if(USE_DSP)
		target_sources(ffb_integration_tests PRIVATE
			${DSP_DIR}/Source/CommonTables/arm_common_tables.c
			${DSP_DIR}/Source/FastMathFunctions/arm_sin_f32.c
			${DSP_DIR}/Source/FastMathFunctions/arm_cos_f32.c
			${DSP_DIR}/Source/FilteringFunctions/arm_biquad_cascade_df1_f32.c
			${DSP_DIR}/Source/FilteringFunctions/arm_biquad_cascade_df1_init_f32.c
			${DSP_DIR}/Source/InterpolationFunctions/arm_spline_interp_f32.c
			${DSP_DIR}/Source/InterpolationFunctions/arm_spline_interp_init_f32.c
			${DSP_DIR}/Source/ControllerFunctions/arm_pid_init_f32.c
			${DSP_DIR}/Source/ControllerFunctions/arm_pid_reset_f32.c
			${DSP_DIR}/Source/StatisticsFunctions/arm_std_f32.c
			${DSP_DIR}/Source/StatisticsFunctions/arm_var_f32.c
		)
		target_include_directories(ffb_integration_tests PRIVATE ${DSP_DIR}/Include ${DSP_DIR}/PrivateInclude)
		target_compile_definitions(ffb_integration_tests PRIVATE USE_DSP_FUNCTIONS ARM_MATH_LOOPUNROLL __GNUC_PYTHON__)
	endif()

	target_link_libraries(ffb_integration_tests PRIVATE Threads::Threads)

	# -funsigned-char: char is unsigned on the ARM target. -fexceptions for C: a resumable task parked in TinyUSB is unwound through usbd.c.
	target_compile_options(ffb_integration_tests PRIVATE -Wall $<$<COMPILE_LANGUAGE:CXX>:-Wno-volatile> $<$<COMPILE_LANGUAGE:C>:-fexceptions> -funsigned-char)
	if(MINGW)
		target_compile_options(ffb_integration_tests PRIVATE -mno-ms-bitfields)
		target_link_options(ffb_integration_tests PRIVATE -static)
	endif()
	if(MINGW OR APPLE)
		# See ffb_target_tests: mallinfo shim. Unverified (no MinGW or macOS toolchain available).
		target_include_directories(ffb_integration_tests BEFORE PRIVATE Code_Coverage/platform/mingw)
		target_sources(ffb_integration_tests PRIVATE Code_Coverage/platform/mingw/host_mallinfo.cpp)
	endif()

	if(FFB_TESTS_SANITIZE)
		target_compile_definitions(ffb_integration_tests PRIVATE HOSTTEST_SANITIZERS)
		target_compile_options(ffb_integration_tests PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=undefined)
		target_link_options(ffb_integration_tests PRIVATE -fsanitize=address,undefined)
	endif()

	# Test cases of ffb_integration_tests excluded from ctest (doctest --test-case-exclude). Same rule as FFB_TESTS_EXCLUDE:
	# only cases that abort the whole run because of a suspected defect belong here.
	set(FFB_INTEGRATION_TESTS_EXCLUDE "" CACHE STRING "Test cases of ffb_integration_tests excluded from ctest (list)")
	set(FFB_INTEGRATION_TESTS_EXCLUDE_SANITIZE "" CACHE STRING "Test cases of ffb_integration_tests additionally excluded from ctest in sanitizer builds (list)")
	set(FFB_INTEGRATION_TESTS_EXCLUDE_32BIT "" CACHE STRING "Test cases of ffb_integration_tests additionally excluded from ctest in 32-bit builds (list)")
	set(FFB_INTEGRATION_TESTS_EXCLUDED ${FFB_INTEGRATION_TESTS_EXCLUDE})
	if(FFB_TESTS_SANITIZE)
		list(APPEND FFB_INTEGRATION_TESTS_EXCLUDED ${FFB_INTEGRATION_TESTS_EXCLUDE_SANITIZE})
	endif()
	if(FFB_TESTS_32BIT)
		list(APPEND FFB_INTEGRATION_TESTS_EXCLUDED ${FFB_INTEGRATION_TESTS_EXCLUDE_32BIT})
	endif()
	list(JOIN FFB_INTEGRATION_TESTS_EXCLUDED "," FFB_INTEGRATION_TESTS_EXCLUDED_ARG)
	message(STATUS "OpenFFBoard tests: ffb_integration_tests excluded from ctest: ${FFB_INTEGRATION_TESTS_EXCLUDED_ARG}")
	if(FFB_INTEGRATION_TESTS_EXCLUDED_ARG)
		add_test(NAME ffb_integration_tests COMMAND ffb_integration_tests "--test-case-exclude=${FFB_INTEGRATION_TESTS_EXCLUDED_ARG}")
	else()
		add_test(NAME ffb_integration_tests COMMAND ffb_integration_tests)
	endif()
	# No time limit of the whole run (owner's decision 2026-11-24, tool WO I2-T1): the suite grows every phase and one process runs every
	# case. The limit is per case, inside the executable (support/CaseWatchdog.cpp, FFB_IT_CASE_TIMEOUT_S). TIMEOUT 0 = no ctest timeout
	# for this entry only (ctest's default of 1500 s, or a --timeout given on the command line, does not apply to it).
	set_tests_properties(ffb_integration_tests PROPERTIES TIMEOUT 0)

	# Self-tests of the integration tooling (the gate script, the hook rules, the bug report generator and its --check of the committed report): stdlib unittest, only with Python 3.
	# test_hooks.py tests the Claude Code hooks, which are meant to run on Linux / macOS only (python3 command): not on Windows.
	if(Python3_Interpreter_FOUND)
		if(WIN32)
			# every tools/test_*.py except test_hooks.py: unittest takes one fnmatch pattern, [!h] leaves out test_h*.py (only test_hooks.py today)
			set(FFB_INTEGRATION_TOOL_TEST_GLOB "test_[!h]*.py")
		else()
			set(FFB_INTEGRATION_TOOL_TEST_GLOB "test_*.py")
		endif()
		add_test(NAME integration_tool_tests
			COMMAND ${Python3_EXECUTABLE} -B -m unittest discover -v
				-s ${CMAKE_CURRENT_SOURCE_DIR}/Integration_Tests/tools -t ${CMAKE_CURRENT_SOURCE_DIR}/Integration_Tests/tools -p "${FFB_INTEGRATION_TOOL_TEST_GLOB}"
			WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR})
		# FFB_IT_EXE: the executable that test_it_gate.py runs for the firing self-test of the per-case watchdog (a hidden, skipped case).
		set_tests_properties(integration_tool_tests PROPERTIES ENVIRONMENT "PYTHONDONTWRITEBYTECODE=1;FFB_IT_EXE=$<TARGET_FILE:ffb_integration_tests>")
		# test_make_integration_bug_report.py also runs make_integration_bug_report.py --check against the committed report
		# (Tests/Integration_Tests/claude/reports/BUG_REPORT.md, generated from the registers of PROGRESS.md): a stale report fails this test.
	else()
		message(STATUS "OpenFFBoard tests: Python 3 not found, integration_tool_tests not added to ctest")
	endif()
endif()
