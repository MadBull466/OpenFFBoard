{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 -B \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_paths.py\"" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 -B \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_bash.py\"" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "integration-test-writer",
        "hooks": [
          { "type": "command", "command": "python3 -B \"$CLAUDE_PROJECT_DIR/.claude/hooks/require_gate_evidence.py\"" }
        ]
      }
    ]
  }
}
